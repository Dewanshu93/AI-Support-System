{
  "name": "@sd/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express + TypeScript backend (modular monolith; AI layer lives in src/ai)",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --use-system-ca src/server.ts",
    "start": "node --use-system-ca dist/server.js",
    "typecheck": "tsc -b && tsc -p tsconfig.spec.json",
    "pretest": "tsc -b ../../packages/shared",
    "test": "jest",
    "start:e2e": "tsx --use-system-ca src/server.ts"
  },
  "dependencies": {
    "@langchain/core": "1.2.14",
    "@langchain/google-genai": "2.3.2",
    "@langchain/langgraph": "1.4.19",
    "@langchain/langgraph-checkpoint-mongodb": "1.4.1",
    "@langchain/openai": "1.6.2",
    "@langchain/textsplitters": "1.0.2",
    "@qdrant/js-client-rest": "1.19.0",
    "@sd/shared": "0.1.0",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "js-yaml": "5.4.2",
    "jsonwebtoken": "9.0.3",
    "mongodb": "7.7.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "tsx": "4.23.15"
  }
}
