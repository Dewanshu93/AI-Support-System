# Copy to .env and fill in values. Never commit .env.
# Secrets are validated at API startup (W1-02); values here are placeholders only.

NODE_ENV=development

# API
API_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# Database: structured data and chunk text (any MongoDB 8.x; ADR-004)
MONGODB_URI=mongodb://localhost:27017/servicedesk?directConnection=true

# Vector store (Qdrant, ADR-004): dense + sparse BM25 chunk vectors
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Auth (W1-05) — at least 32 bytes
JWT_SECRET=
# Optional shared demo password for the login picker
DEMO_PASSWORD=
# Optional: pin "today" (YYYY-MM-DD) for timesheets and the dashboard, e.g. for a rehearsed demo.
DEMO_TODAY=

# Escalation email delivery (UC-07): mock (default) stores emails in the outbox without sending.
# smtp is not available yet (needs an approved mail dependency) and stops the API at startup.
EMAIL_DELIVERY=mock

# LLM providers (W1-09) — provider/model selection lives in config/models.yaml
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Local fallback model (ADR-018), e.g. http://localhost:11434; leave blank to skip it
OLLAMA_BASE_URL=
# LLM_MODE=cache reuses saved replies in development (.llm-cache/, git-ignored)
LLM_MODE=

# Jira Cloud, read-only (UC-18): the Atlassian OAuth 2.0 app from developer.atlassian.com.
# Employees then connect their own Jira from the Tasks page. Leave blank to keep the mock tracker.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Callback URL registered in the Atlassian app (default shown)
JIRA_REDIRECT_URI=http://localhost:3000/api/integrations/jira/callback
# Optional: which site to use when an account has several, e.g. https://yourcompany.atlassian.net
JIRA_SITE_URL=
# GitHub, read-only (UC-19): a GitHub App (Settings > Developer settings > GitHub Apps) with
# read-only Pull requests, Issues and Metadata permissions, installed on your repositories.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Callback URL registered in the GitHub App (default shown)
GITHUB_REDIRECT_URI=http://localhost:3000/api/integrations/github/callback
# Encrypts stored tokens (all connected apps). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Behind a corporate proxy (Node >= 24.5): NODE_USE_ENV_PROXY=1 and HTTPS_PROXY=http://proxy:port

# Optional overrides (defaults: <repo>/config and <repo>/.env)
CONFIG_DIR=
ENV_FILE=

# Web (Next.js reads API_URL; defaults to http://localhost:4000)
# Express API that the web app proxies /api/* to (server-side only)
API_URL=http://localhost:4000

# Integration tests (W1-04): tests create and remove their own database / collection
MONGODB_TEST_URI=
QDRANT_TEST_URL=
