{
  "name": "ai-service-desk",
  "version": "0.1.0",
  "private": true,
  "description": "AI Service Desk Front Door — modular monolith (web + api + shared)",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web",
    "e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w @sd/shared && npm run build -w @sd/api && npm run build -w @sd/web",
    "dev:api": "npm run build -w @sd/shared && npm run dev -w @sd/api",
    "dev:web": "npm run build -w @sd/shared && npm run dev -w @sd/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts",
    "db:indexes": "npm run build -w @sd/shared && tsx scripts/create-indexes.ts",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @sd/e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
